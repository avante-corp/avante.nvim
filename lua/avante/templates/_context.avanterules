{% if selected_files -%}
<selected_files>
{%- for file in selected_files %}
<file path="{{file.path|escape}}" language="{{file.file_type|escape}}">
{% if file.content is none -%}
Use the view tool to read the current contents before inspecting or editing this file.
{% else -%}
{{file.content|replace("</file>", "&lt;/file&gt;")|replace("</selected_files>", "&lt;/selected_files&gt;")}}
{% endif -%}
</file>
{%- endfor %}
</selected_files>
{%- endif %}

{% if selected_code -%}
<selected_code path="{{selected_code.path|escape}}" language="{{selected_code.file_type|escape}}">
{{selected_code.content|replace("</selected_code>", "&lt;/selected_code&gt;")}}
</selected_code>
{%- endif %}

{% if recently_viewed_files -%}
<recently_viewed_files>
{%- for file in recently_viewed_files %}
{{loop.index}}. {{file}}
{%- endfor %}
</recently_viewed_files>
{%- endif %}
