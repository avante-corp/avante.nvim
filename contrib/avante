#!/usr/bin/env bash
# launches neovim with avante to mimic a typical harness
# Usage: avante [--provider NAME] [prompt...] [-- NVIM_ARGS...]
# Unrecognized arguments before -- form the prompt.
show_help() {
  cat <<'EOF'
Usage: avante [--provider NAME] [prompt...] [-- NVIM_ARGS...]

Launch Neovim with Avante's Zen Mode and submit prompt.

Options:
  --provider NAME    Switch to NAME before submitting the prompt
  -h, --help         Show this help and exit
  --                 Pass all remaining arguments to Neovim

Arguments before -- that are not recognized as options form prompt,
joined with spaces. Arguments after -- are passed unchanged to Neovim.
EOF
}

provider=""
prompt=()
nvim_args=()
while (( $# )); do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    --provider)
      if (( $# < 2 )) || [[ -z $2 || $2 == --* ]]; then
        printf '%s\n' 'avante: --provider requires a name' >&2
        exit 2
      fi
      provider=$2
      shift 2
      ;;
    --provider=*)
      provider=${1#*=}
      if [[ -z $provider ]]; then
        printf '%s\n' 'avante: --provider requires a name' >&2
        exit 2
      fi
      shift
      ;;
    --)
      shift
      nvim_args=("$@")
      break
      ;;
    *)
      prompt+=("$1")
      shift
      ;;
  esac
done

# Encode user input so it can be embedded safely in Lua.
prompt_hex=$(printf '%s' "${prompt[*]}" | od -An -v -tx1 | tr -d ' \n')
provider_command=""
if [[ -n $provider ]]; then
  # Escape the provider for a single-quoted Lua string literal.
  provider=${provider//\\/\\\\}
  provider=${provider//\'/\\\'}
  provider=${provider//$'\n'/\\n}
  provider=${provider//$'\r'/\\r}
  provider_command="api.switch_provider('$provider');"
fi
# Switch after startup configuration has loaded, immediately before asking.
exec nvim \
  "${nvim_args[@]}" \
  -c "lua vim.defer_fn(function() local api = require('avante.api'); $provider_command local prompt = ('$prompt_hex'):gsub('..', function(byte) return string.char(tonumber(byte, 16)) end); api.zen_mode({ question = prompt }) end, 100)"
