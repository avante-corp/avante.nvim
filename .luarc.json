{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "lua/?.lua",
      "lua/?/init.lua",
      "?.lua",
      "?/init.lua"
    ],
    "pathStrict": true
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME/lua",
      "${3rd}/luv/library",
      "${workspaceFolder}/target/tests/deps/share/lua/5.1",
      "${env:DEPS_PATH}/share/lua/5.1"
    ],
    "ignoreDir": [
      "tests"
    ],
    "checkThirdParty": "Disable"
  },
  "diagnostics": {
    "neededFileStatus": {
      "incomplete-signature-doc": "Any!",
      "missing-local-export-doc": "Any!"
    }
  },
  "type": {
    "checkTableShape": true
  }
}
