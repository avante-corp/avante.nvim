{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "lua/?.lua",
      "lua/?/init.lua",
      "?.lua",
      "?/init.lua"
    ],
    "pathStrict": true
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME/lua",
      "${3rd}/luv/library",
      "${workspaceFolder}/target/tests/deps/share/lua/5.1",
      "${env:DEPS_PATH}/share/lua/5.1"
    ],
    "ignoreDir": [
      "tests"
    ],
    "checkThirdParty": "Disable"
  },
  "diagnostics": {
    "neededFileStatus": {
      "codestyle-check": "None",
      "duplicate-index": "Any!",
      "duplicate-set-field": "Any!",
      "incomplete-signature-doc": "Any!",
      "missing-local-export-doc": "Any!",
      "no-unknown": "Any!",
      "redefined-local": "Any!",
      "trailing-space": "None"
    },
    "severity": {
      "undefined-global": "Error",
      "unused-local": "Warning",
      "unused-function": "Warning",
      "unused-label": "Warning",
      "deprecated": "Warning!",
      "duplicate-index": "Error",
      "duplicate-set-field": "Error",
      "redefined-local": "Hint",
      "redundant-parameter": "Warning",
      "redundant-value": "Warning",
      "need-check-nil": "Error",
      "undefined-field": "Error",
      "missing-parameter": "Error",
      "param-type-mismatch": "Error",
      "assign-type-mismatch": "Error",
      "no-unknown": "Warning!"
    },
    "unusedLocalExclude": ["_*"]
  },
  "type": {
    "checkTableShape": true,
    "castNumberToInteger": true,
    "weakUnionCheck": false,
    "weakNilCheck": false
  },
  "format": {
    "enable": false
  }
}
