{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "prerelease": true,
      "bump-patch-for-minor-pre-major": true,
      "bump-minor-pre-major": true,
      "release-type": "go",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "lua/avante/version.lua"
        },
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name == 'avante-acp' || @.name == 'avante-html2md' || @.name == 'avante-repo-map' || @.name == 'avante-templates' || @.name == 'avante-tokenizers')].version"
        }
      ]
    }
  }
}
